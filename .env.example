# Portul serverului Express (implicit 3001)
PORT=3001

# Parola de admin pentru /api/admin/login (dacă lipsește, login-ul răspunde 503)
ADMIN_PASSWORD=

# Secret pentru semnarea JWT admin (dacă lipsește, se generează aleator la pornire)
JWT_SECRET=

# URL-ul API-ului pentru front-end (gol = request-uri relative, prin proxy-ul Vite)
VITE_API_URL=

# Cheie de 32 de bytes în base64 pentru criptarea formularelor 230 (dacă lipsește, formularul online e dezactivat)
# Generare: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
F230_KEY=
