# Portul serverului Express (implicit 3001)
PORT=3001

# Parola de admin pentru /api/admin/login (dacă lipsește, login-ul răspunde 503)
ADMIN_PASSWORD=

# Secret pentru semnarea JWT admin (dacă lipsește, se generează aleator la pornire)
JWT_SECRET=

# URL-ul API-ului pentru front-end (gol = request-uri relative, prin proxy-ul Vite)
VITE_API_URL=

# Cheie de 32 de bytes în base64 pentru criptarea formularelor 230
# Dacă lipsește (sau nu e validă), serverul generează automat server/data/f230.key (ține o copie de siguranță a cheii)
# Generare: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
F230_KEY=

# Date asociație folosite ca valori implicite pe site (editabile din admin, valorile din admin au prioritate)
ORG_NAME=
ORG_CIF=
ORG_REGISTRY=
ORG_ADDRESS=
ORG_REPRESENTATIVE=
ORG_IBAN=
ORG_BANK=
ORG_EMAIL=
ORG_PHONE=
ORG_CONTACT_ADDRESS=
